module

public import Silmaril.Calculi.TypedLambda.Denotation
public import Silmaril.Semantics.Domain.ScottInduction
public import Silmaril.Semantics.Domain.Sieber

/-! # Logical relations over a domain model

Semantic logical relations, the technique behind the undefinability of
parallel or (Theorem 40, §8.1; the proof the notes cite from Sieber). Given a
`Model` of a signature and, for each base type, a relation `R b` between
`n`-tuples of elements of the base domain, `LogRel R τ` extends it to every
type: at `σ -> τ` two tuples of functions are related when they send related
arguments to related results.

The *fundamental lemma* (`LogRel.fundamental`) says that the denotation of
every term relates to itself, provided each operator of the signature
preserves the relation. Nothing else is needed, because variables,
abstraction and application are handled once and for all.

Operators such as `fix` preserve the relation when it is *admissible*
(Remark 4) at the type of the fixed point: it contains the all-`⊥` tuple and
is closed under lubs of chains. Admissibility at base types propagates to all
types (`LogRel.admissible`), so it is enough to check it at base types. The
tuples of the relation are functions `Fin n → ⟦τ⟧`, whose pointwise order
makes them a domain, so `Silmaril.Semantics.Domain.Admissible` applies directly.

Everything is stated for an arbitrary signature, model and arity `n`, so the
framework can be reused for other languages. The last section instantiates it
with Sieber's ternary relation (`Silmaril.Semantics.Domain.SieberRel`) at every base
type, for any model: `SieberLogRel` holds of every triple whose first or
second component is `⊥`, is admissible at every type, and is preserved by the
conditional into any type when the condition ranges over `Part Bool`.
-/

@[expose] public section

namespace Silmaril.Calculi.TypedLambda


open OmegaCompletePartialOrder Silmaril.Semantics.Domain Cslib.LambdaCalculus.LocallyNameless.Stlc

variable {S : Signature} {M : Model S} {n : ℕ}

/-- The `n`-ary logical relation over the model `M` generated by the relations
`R b` at base types: at `σ -> τ`, a tuple of functions is related when it
sends every related tuple of arguments to a related tuple of results. -/
def LogRel (M : Model S) {n : ℕ} (R : ∀ b : S.Base, (Fin n → M.ty (.base b)) → Prop) :
    (τ : Ty S.Base) → (Fin n → M.ty τ) → Prop
  | .base b, d => R b d
  | .arrow σ τ, f =>
      ∀ d : Fin n → M.ty σ, LogRel M R σ d → LogRel M R τ fun i => Model.app (f i) (d i)

namespace LogRel

variable {R : ∀ b : S.Base, (Fin n → M.ty (.base b)) → Prop}

/-- At a base type the logical relation is the base relation. -/
theorem base_iff {b : S.Base} {d : Fin n → M.ty (.base b)} : LogRel M R (.base b) d ↔ R b d :=
  Iff.rfl

/-- At `σ -> τ`, related functions send related arguments to related
results. -/
theorem arrow_iff {σ τ : Ty S.Base} {f : Fin n → M.ty (σ ⤳ τ)} :
    LogRel M R (σ ⤳ τ) f ↔
      ∀ d : Fin n → M.ty σ, LogRel M R σ d → LogRel M R τ fun i => Model.app (f i) (d i) :=
  Iff.rfl

/-- Related environments: related values for every variable. -/
def Env (M : Model S) (R : ∀ b : S.Base, (Fin n → M.ty (.base b)) → Prop) {Γ : Ctx S.Base}
    (ρ : Fin n → M.Env Γ) : Prop :=
  ∀ a (x : Var Γ a), LogRel M R a fun i => ρ i a x

/-- The empty environments are related. -/
theorem Env.nil (ρ : Fin n → M.Env []) : Env M R ρ := fun _ x => x.elim

/-- Extending related environments with related values gives related
environments. -/
theorem Env.cons {Γ : Ctx S.Base} {σ : Ty S.Base} {ρ : Fin n → M.Env Γ} (hρ : Env M R ρ)
    {d : Fin n → M.ty σ} (hd : LogRel M R σ d) : Env M R fun i => d i ::ₜ ρ i := by
  intro a x
  cases x with
  | zero => exact hd
  | succ x => exact hρ _ x

/-- An operator preserves the relation: related argument tuples give related
results. -/
def OpPreserves (M : Model S) (R : ∀ b : S.Base, (Fin n → M.ty (.base b)) → Prop)
    {as : List (Ty S.Base)} {τ : Ty S.Base} (o : S.Op as τ) : Prop :=
  ∀ xs : Fin n → M.Env as, Env M R xs → LogRel M R τ fun i => M.op o (xs i)

/-- The fundamental lemma of logical relations: if every operator preserves
the relation, then so does every term, in the sense that related environments
give related denotations. -/
theorem fundamental (hop : ∀ {as τ} (o : S.Op as τ), OpPreserves M R o) :
    {Γ : Ctx S.Base} → {τ : Ty S.Base} → (t : Term S Γ τ) → (ρ : Fin n → M.Env Γ) →
      Env M R ρ → LogRel M R τ fun i => M.denote t (ρ i)
  | _, _, .var x, _, hρ => hρ _ x
  | _, _, .lam t, _, hρ => fun _ hd => fundamental hop t _ (hρ.cons hd)
  | _, _, .app t u, ρ, hρ => fundamental hop t ρ hρ _ (fundamental hop u ρ hρ)
  | _, _, .op o args, ρ, hρ =>
      hop o (fun i a x => M.denote (args a x) (ρ i)) fun a x => fundamental hop (args a x) ρ hρ

/-- The fundamental lemma for closed terms: the denotation of a closed term,
repeated `n` times, is related to itself. -/
theorem fundamental_closed (hop : ∀ {as τ} (o : S.Op as τ), OpPreserves M R o)
    {τ : Ty S.Base} (t : Term S [] τ) : LogRel M R τ fun _ => M.denoteClosed t :=
  fundamental hop t (fun _ => Tuple.nil) (Env.nil _)

section Bottom

/-- If the relation at every base type holds of all tuples whose `j`-th
component is `⊥`, then so does the relation at every type. -/
theorem of_apply_eq_bot (j : Fin n)
    (hbase : ∀ b (d : Fin n → M.ty (.base b)), d j = ⊥ → R b d) :
    (τ : Ty S.Base) → (d : Fin n → M.ty τ) → d j = ⊥ → LogRel M R τ d
  | .base b, d, h => hbase b d h
  | .arrow _ τ, f, h => fun d _ => of_apply_eq_bot j hbase τ _ <| by
      show Model.app (f j) (d j) = ⊥
      rw [h]
      rfl

/-- If the relation at every base type holds of all tuples that are `⊥` at
every index in `J`, then so does the relation at every type. -/
theorem of_forall_eq_bot (J : Fin n → Prop)
    (hbase : ∀ b (d : Fin n → M.ty (.base b)), (∀ j, J j → d j = ⊥) → R b d) :
    (τ : Ty S.Base) → (d : Fin n → M.ty τ) → (∀ j, J j → d j = ⊥) → LogRel M R τ d
  | .base b, d, h => hbase b d h
  | .arrow _ τ, f, h => fun d _ => of_forall_eq_bot J hbase τ _ fun j hj => by
      show Model.app (f j) (d j) = ⊥
      rw [h j hj]
      rfl

end Bottom

section Admissible

/-- Applying a tuple of functions to a fixed tuple of arguments, componentwise,
is continuous. -/
theorem ωScottContinuous_appTuple {σ τ : Ty S.Base} (d : Fin n → M.ty σ) :
    ωScottContinuous fun f : Fin n → M.ty (σ ⤳ τ) => fun i => Model.app (f i) (d i) :=
  ωScottContinuous.of_apply₂ fun i =>
    Model.ωScottContinuous_app (ωScottContinuous.apply i) (ωScottContinuous_const (d i))

/-- Chain-closure at `σ -> τ` follows from chain-closure at `τ`: the relation
at `σ -> τ` is an intersection of inverse images of the relation at `τ`
(Propositions 19 and 20). -/
theorem chainClosed_arrow {σ τ : Ty S.Base} (hτ : ChainClosed {d | LogRel M R τ d}) :
    ChainClosed {f | LogRel M R (σ ⤳ τ) f} := fun c hc d hd =>
  ChainClosed.preimage (ωScottContinuous_appTuple d) hτ c fun k => hc k d hd

/-- The all-`⊥` tuple at `σ -> τ` is related if the all-`⊥` tuple at `τ` is. -/
theorem bot_mem_arrow {σ τ : Ty S.Base} (hτ : LogRel M R τ ⊥) : LogRel M R (σ ⤳ τ) ⊥ :=
  fun _ _ => hτ

/-- Admissibility at `σ -> τ` follows from admissibility at the result type
`τ`, whatever the relation at `σ`. -/
theorem admissible_arrow {σ τ : Ty S.Base} (hτ : Admissible {d | LogRel M R τ d}) :
    Admissible {f | LogRel M R (σ ⤳ τ) f} :=
  ⟨bot_mem_arrow hτ.1, chainClosed_arrow hτ.2⟩

/-- If the base relations are admissible (contain the all-`⊥` tuple and are
closed under lubs of chains), then the logical relation is admissible at every
type. -/
theorem admissible (hbase : ∀ b, Admissible {d | R b d}) :
    ∀ τ : Ty S.Base, Admissible {d | LogRel M R τ d}
  | .base b => hbase b
  | .arrow _ τ => admissible_arrow (admissible hbase τ)

/-- Scott induction for logical relations (Theorem 17): if the relation is
admissible at `τ`, then the least fixed points of a related tuple of functions
`τ -> τ` are related. The tuple of fixed points is the fixed point of the
componentwise map on `Fin n → ⟦τ⟧` (`Silmaril.Semantics.Domain.fix_piMap`), which preserves the
relation. -/
theorem fix_mem {τ : Ty S.Base} (hτ : Admissible {d | LogRel M R τ d})
    {f : Fin n → M.ty (τ ⤳ τ)} (hf : LogRel M R (τ ⤳ τ) f) :
    LogRel M R τ fun i => fix (Model.fn (f i)) := by
  have h := Silmaril.Semantics.Domain.fix_mem (f := piMap fun i => Model.fn (f i)) hτ fun d hd => hf d hd
  rwa [fix_piMap] at h

end Admissible

end LogRel

section Sieber

/-- Sieber's ternary logical relation over a model: `SieberRel`
(`d₀ = ⊥ ∨ d₁ = ⊥ ∨ d₀ = d₁ = d₂`) at every base type, extended to all types. -/
abbrev SieberLogRel (M : Model S) : (τ : Ty S.Base) → (Fin 3 → M.ty τ) → Prop :=
  LogRel M fun _ d => SieberRel d

namespace SieberLogRel

/-- Triples whose first or second component is `⊥` are related at every
type. -/
theorem of_bot {τ : Ty S.Base} {d : Fin 3 → M.ty τ} (h : d 0 = ⊥ ∨ d 1 = ⊥) :
    SieberLogRel M τ d := by
  rcases h with h | h
  · exact LogRel.of_apply_eq_bot 0 (fun _ _ h => Or.inl h) τ d h
  · exact LogRel.of_apply_eq_bot 1 (fun _ _ h => Or.inr (Or.inl h)) τ d h

/-- Sieber's logical relation is admissible at every type. -/
theorem admissible (τ : Ty S.Base) : Admissible {d | SieberLogRel M τ d} :=
  LogRel.admissible (fun _ => SieberRel.admissible) τ

/-- The conditional `if c then x else y`, with a related triple of conditions
in `𝔹⊥`, preserves Sieber's relation at every type. -/
theorem condFun_mem {τ : Ty S.Base} {c : Fin 3 → Part Bool} (hc : SieberRel c)
    {x y : Fin 3 → M.ty τ} (hx : SieberLogRel M τ x) (hy : SieberLogRel M τ y) :
    SieberLogRel M τ fun i => condFun (c i) (x i) (y i) := by
  by_cases h₀ : c 0 = ⊥
  · exact of_bot (Or.inl (by simp only [h₀]; exact condFun_none _ _))
  by_cases h₁ : c 1 = ⊥
  · exact of_bot (Or.inr (by simp only [h₁]; exact condFun_none _ _))
  simp only [hc.eq_zero h₀ h₁]
  rcases condFun_cases (c 0) with h | h | h
  · exact absurd h h₀
  · simpa only [h, condFun_true] using hx
  · simpa only [h, condFun_false] using hy

end SieberLogRel

end Sieber

end Silmaril.Calculi.TypedLambda
