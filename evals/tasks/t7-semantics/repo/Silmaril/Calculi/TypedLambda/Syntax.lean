module

public import Cslib.Languages.LambdaCalculus.LocallyNameless.Stlc.Basic

/-! # Simply typed λ-calculi over a signature

A *signature* supplies base types and fully applied operators, each with a list
of argument types and a result type. The terms over a signature are the simply
typed λ-calculus extended with fully applied operators. PCF (§5.1 of the
denotational semantics notes) is one such calculus: its constants,
`succ(t)`, `if b then t else t'`, `fix(t)` and, for PCF+`por`, `por(t, t')`
are all operators.

Types are CSLib's `Stlc.Ty`, generated by base types and `⤳`.

Terms are intrinsically typed with de Bruijn indices. A variable of type `a`
in context `Γ` is a position `Var Γ a`, so α-equivalent terms are equal.
`Raw.equivTerm` identifies intrinsic terms with the well-typed raw terms of
the same signature, generalizing the set `Pcf_{Γ,τ}` in Definition 17.
A family indexed by the positions of a context is a `Tuple`. Renamings, substitutions,
operator arguments and (later) semantic environments are all tuples.

The numbered definitions refer to the lecture notes,
§5.1 (printed pages 38–40, PDF pages 39–41).
-/

@[expose] public section

namespace Silmaril.Calculi.TypedLambda

open Cslib.LambdaCalculus.LocallyNameless.Stlc

universe u v w

export Cslib.LambdaCalculus.LocallyNameless.Stlc (Ty)

-- Equality of types is decidable (CSLib does not derive it).
deriving instance DecidableEq for Ty

/-- A type is never a function type with itself as domain. -/
theorem _root_.Cslib.LambdaCalculus.LocallyNameless.Stlc.Ty.arrow_ne_self {B : Type} :
    ∀ σ τ : Ty B, σ ⤳ τ ≠ σ
  | .base _, _, h => nomatch h
  | .arrow σ₁ σ₂, _, h => arrow_ne_self σ₁ σ₂ (Ty.arrow.inj h).1

/-- A signature of base types and fully applied operators. An operator
`o : Op as τ` takes arguments of the types `as` and returns a result of
type `τ`. -/
structure Signature where
  /-- Base types. -/
  Base : Type
  /-- Operators, indexed by argument types and result type. -/
  Op : List (Ty Base) → Ty Base → Type

/-- A typing context: the types of the variables, innermost first. -/
abbrev Ctx (B : Type) := List (Ty B)

/-- A position of type `a` in a list. -/
inductive Var {α : Type u} : List α → α → Type u
  /-- The first position. -/
  | zero {a : α} {as : List α} : Var (a :: as) a
  /-- A later position. -/
  | succ {a b : α} {as : List α} : Var as a → Var (b :: as) a
  deriving DecidableEq

namespace Var

variable {α : Type u}

/-- There is no position in the empty list. -/
def elim {a : α} {C : Sort v} : Var [] a → C := nofun

/-- The index of a position. -/
def toNat {as : List α} {a : α} : Var as a → ℕ
  | zero => 0
  | succ x => x.toNat + 1

theorem get_toNat {as : List α} {a : α} (x : Var as a) : as[x.toNat]? = some a := by
  induction x with
  | zero => rfl
  | succ _ ih => exact ih

/-- The index of a position is below the length of the list. -/
theorem toNat_lt {as : List α} {a : α} (x : Var as a) : x.toNat < as.length :=
  (List.getElem?_eq_some_iff.mp x.get_toNat).1

theorem toNat_injective {as : List α} {a : α} {x y : Var as a} (h : x.toNat = y.toNat) :
    x = y := by
  induction x with
  | zero => cases y with
    | zero => rfl
    | succ y => exact absurd h (by simp [toNat])
  | succ x ih => cases y with
    | zero => exact absurd h (by simp [toNat])
    | succ y => exact congrArg succ (ih (Nat.succ.inj h))

/-- The position with a given `Fin` index. -/
def ofFin : {as : List α} → (i : Fin as.length) → Var as (as.get i)
  | _ :: _, ⟨0, _⟩ => zero
  | _ :: _, ⟨i + 1, h⟩ => succ (ofFin ⟨i, Nat.lt_of_succ_lt_succ h⟩)

@[simp] theorem toNat_ofFin {as : List α} (i : Fin as.length) : (ofFin i).toNat = i := by
  induction as with
  | nil => exact i.elim0
  | cons a as ih =>
      match i with
      | ⟨0, _⟩ => rfl
      | ⟨i + 1, h⟩ => exact congrArg (· + 1) (ih ⟨i, Nat.lt_of_succ_lt_succ h⟩)

/-- The position with index `n`, given that `as[n]? = some a`. -/
def ofGetElem? : {as : List α} → {a : α} → (n : ℕ) → as[n]? = some a → Var as a
  | [], _, _, h => nomatch h
  | _ :: _, _, 0, h => Option.some.inj h ▸ zero
  | _ :: _, _, n + 1, h => succ (ofGetElem? n h)

@[simp] theorem toNat_ofGetElem? {as : List α} {a : α} (n : ℕ) (h : as[n]? = some a) :
    (ofGetElem? n h).toNat = n := by
  induction as generalizing n with
  | nil => exact nomatch h
  | cons b as ih =>
      cases n with
      | zero => cases Option.some.inj h; rfl
      | succ n => exact congrArg (· + 1) (ih n h)

/-- The index of a position, as an element of `Fin as.length`. -/
def toFin {as : List α} {a : α} (x : Var as a) : Fin as.length :=
  ⟨x.toNat, (List.getElem?_eq_some_iff.mp x.get_toNat).1⟩

@[simp] theorem toFin_val {as : List α} {a : α} (x : Var as a) : x.toFin.val = x.toNat := rfl

@[simp] theorem toFin_ofFin {as : List α} (i : Fin as.length) : (ofFin i).toFin = i :=
  Fin.ext (toNat_ofFin i)

/-- The entry at the index of a position is its type. -/
theorem get_toFin {as : List α} {a : α} (x : Var as a) : as.get x.toFin = a :=
  (List.getElem?_eq_some_iff.mp x.get_toNat).2

/-- The index of `zero`. Not `@[simp]`, to leave existing `simp` normal forms unchanged. -/
theorem toNat_zero {a : α} {as : List α} : (zero : Var (a :: as) a).toNat = 0 := rfl

/-- The index of a successor position. Not `@[simp]`. -/
theorem toNat_succ {a b : α} {as : List α} (x : Var as a) :
    (succ (b := b) x).toNat = x.toNat + 1 := rfl

/-- Positions of a list, with their types, are its `Fin` indices. -/
def equivFin (as : List α) : (Σ a, Var as a) ≃ Fin as.length where
  toFun x := x.2.toFin
  invFun i := ⟨_, ofFin i⟩
  left_inv := by
    rintro ⟨a, x⟩
    have h : as.get x.toFin = a := get_toFin x
    have key : ∀ (b : α) (hb : b = a) (y : Var as b), y.toNat = x.toNat →
        (⟨b, y⟩ : Σ a, Var as a) = ⟨a, x⟩ := by
      rintro b rfl y hy
      rw [toNat_injective hy]
    exact key _ h _ (toNat_ofFin _)
  right_inv i := toFin_ofFin i

/-- Transport a position along a map of the list's elements. -/
def map {β : Type v} (f : α → β) : {as : List α} → {a : α} → Var as a → Var (as.map f) (f a)
  | _, _, zero => zero
  | _, _, succ x => succ (map f x)

end Var

/-- A family indexed by the positions of a list. -/
abbrev Tuple {α : Type u} (X : α → Type v) (as : List α) : Type (max u v) :=
  ∀ a, Var as a → X a

namespace Tuple

variable {α : Type u} {X : α → Type v} {a b : α} {as : List α}

/-- The empty tuple. -/
def nil : Tuple X [] := fun _ x => x.elim

/-- Extend a tuple at the front. -/
def cons (x : X a) (xs : Tuple X as) : Tuple X (a :: as)
  | _, .zero => x
  | _, .succ v => xs _ v

@[inherit_doc] infixr:67 " ::ₜ " => Tuple.cons

/-- The first component. -/
def head (xs : Tuple X (a :: as)) : X a := xs a .zero

/-- The remaining components. -/
def tail (xs : Tuple X (a :: as)) : Tuple X as := fun _ v => xs _ (.succ v)

/-- Apply a family of functions componentwise. -/
def map {Y : α → Type w} (f : ∀ a, X a → Y a) (xs : Tuple X as) : Tuple Y as :=
  fun a v => f a (xs a v)

/-- Replace one component. -/
def set : {as : List α} → Tuple X as → {a : α} → Var as a → X a → Tuple X as
  | _ :: _, xs, _, .zero, y => y ::ₜ xs.tail
  | _ :: _, xs, _, .succ v, y => xs.head ::ₜ xs.tail.set v y

@[simp] theorem cons_zero (x : X a) (xs : Tuple X as) : (x ::ₜ xs) a .zero = x := rfl

@[simp] theorem cons_succ (x : X a) (xs : Tuple X as) (v : Var as b) :
    (x ::ₜ xs) b (.succ v) = xs b v := rfl

@[simp] theorem head_cons (x : X a) (xs : Tuple X as) : (x ::ₜ xs).head = x := rfl

@[simp] theorem tail_cons (x : X a) (xs : Tuple X as) : (x ::ₜ xs).tail = xs := rfl

theorem ext {xs ys : Tuple X as} (h : ∀ a v, xs a v = ys a v) : xs = ys :=
  funext fun a => funext fun v => h a v

theorem eq_nil (xs : Tuple X []) : xs = nil := ext fun _ v => v.elim

@[simp] theorem cons_head_tail (xs : Tuple X (a :: as)) : xs.head ::ₜ xs.tail = xs :=
  ext fun _ v => by cases v <;> rfl

@[simp] theorem map_apply {Y : α → Type w} (f : ∀ a, X a → Y a) (xs : Tuple X as)
    (b : α) (v : Var as b) : xs.map f b v = f b (xs b v) := rfl

@[simp] theorem map_cons {Y : α → Type w} (f : ∀ a, X a → Y a) (x : X a) (xs : Tuple X as) :
    (x ::ₜ xs).map f = f a x ::ₜ xs.map f :=
  ext fun _ v => by cases v <;> rfl

@[simp] theorem set_same {as : List α} (xs : Tuple X as) {a : α} (v : Var as a) (y : X a) :
    xs.set v y a v = y := by
  induction v with
  | zero => rfl
  | succ v ih => exact ih _ _

theorem set_other {as : List α} (xs : Tuple X as) {a b : α} (v : Var as a) (w : Var as b)
    (y : X a) (h : v.toNat ≠ w.toNat) : xs.set v y b w = xs b w := by
  induction v generalizing b with
  | zero => cases w with
    | zero => exact absurd rfl h
    | succ w => rfl
  | succ v ih => cases w with
    | zero => rfl
    | succ w => exact ih _ w _ (fun h' => h (congrArg (· + 1) h'))

/-- Replacing one component by a larger one gives a larger tuple, in the
pointwise order. -/
theorem set_mono [∀ a, Preorder (X a)] {as : List α} (xs : Tuple X as) {a : α}
    (v : Var as a) {y y' : X a} (hy : y ≤ y') : xs.set v y ≤ xs.set v y' := by
  induction v with
  | zero => intro b w; cases w with
    | zero => exact hy
    | succ w => exact le_rfl
  | succ v ih => intro b w; cases w with
    | zero => exact le_rfl
    | succ w => exact ih xs.tail hy b w

/-- The tuple with components `f i` at the positions `Var.ofFin i`. -/
def ofFn : {as : List α} → (∀ i : Fin as.length, X (as.get i)) → Tuple X as
  | [], _ => nil
  | _ :: _, f => f ⟨0, Nat.zero_lt_succ _⟩ ::ₜ ofFn fun i => f i.succ

@[simp] theorem ofFn_ofFin {as : List α} (f : ∀ i : Fin as.length, X (as.get i))
    (i : Fin as.length) : ofFn f _ (Var.ofFin i) = f i := by
  induction as with
  | nil => exact i.elim0
  | cons a as ih =>
      match i with
      | ⟨0, _⟩ => rfl
      | ⟨i + 1, h⟩ => exact ih (fun i => f i.succ) ⟨i, Nat.lt_of_succ_lt_succ h⟩

/-- A tuple is determined by its components at the positions `Var.ofFin i`. -/
@[simp] theorem ofFn_eta {as : List α} (xs : Tuple X as) :
    ofFn (fun i => xs _ (Var.ofFin i)) = xs := by
  induction as with
  | nil => exact (eq_nil _).symm
  | cons a as ih => exact (congrArg (xs.head ::ₜ ·) (ih xs.tail)).trans (cons_head_tail xs)

/-- Tuples over a list are functions on its `Fin` indices. -/
def equivFn (as : List α) : Tuple X as ≃ (∀ i : Fin as.length, X (as.get i)) where
  toFun xs i := xs _ (Var.ofFin i)
  invFun := ofFn
  left_inv := ofFn_eta
  right_inv f := funext (ofFn_ofFin f)

theorem map_set {Y : α → Type w} (f : ∀ a, X a → Y a) {as : List α} (xs : Tuple X as)
    {a : α} (v : Var as a) (y : X a) : (xs.set v y).map f = (xs.map f).set v (f a y) := by
  induction v with
  | zero => exact ext fun _ w => by cases w <;> rfl
  | succ v ih =>
      refine ext fun _ w => ?_
      cases w with
      | zero => rfl
      | succ w => exact congrFun (congrFun (ih xs.tail y) _) w

/-- `Tuple.set` preserves a reflexive componentwise relation. -/
theorem set_rel {R : ∀ a, X a → X a → Prop} (hR : ∀ a z, R a z z) {as : List α}
    (xs : Tuple X as) {a : α} (v : Var as a) {y y' : X a} (h : R a y y') :
    ∀ b w, R b (xs.set v y b w) (xs.set v y' b w) := by
  induction v with
  | zero => intro b w; cases w with
    | zero => exact h
    | succ w => exact hR _ _
  | succ v ih => intro b w; cases w with
    | zero => exact hR _ _
    | succ w => exact ih xs.tail h b w

/-- A tuple of one element. -/
abbrev single (x : X a) : Tuple X [a] := x ::ₜ nil

theorem eq_single (xs : Tuple X [a]) : xs = single xs.head :=
  ext fun _ v => by cases v with
    | zero => rfl
    | succ v => exact v.elim

@[simp] theorem single_head (xs : Tuple X [a]) : single xs.head = xs := (eq_single xs).symm

theorem eq_cons (xs : Tuple X (a :: as)) : xs = xs.head ::ₜ xs.tail := (cons_head_tail xs).symm

/-- A two-element tuple is determined by its components. -/
theorem eta₂ {b : α} (xs : Tuple X [a, b]) : xs = xs.head ::ₜ single xs.tail.head := by
  calc xs = xs.head ::ₜ xs.tail := eq_cons xs
    _ = _ := by rw [single_head]

/-- A three-element tuple is determined by its components. -/
theorem eta₃ {b c : α} (xs : Tuple X [a, b, c]) :
    xs = xs.head ::ₜ xs.tail.head ::ₜ single xs.tail.tail.head := by
  calc xs = xs.head ::ₜ xs.tail := eq_cons xs
    _ = _ := by rw [← eta₂ xs.tail]

theorem cons_injective {x y : X a} {xs ys : Tuple X as} (h : x ::ₜ xs = y ::ₜ ys) :
    x = y ∧ xs = ys :=
  ⟨congrArg head h, congrArg tail h⟩

end Tuple

variable (S : Signature)

/-- Intrinsically typed terms over the signature `S` in context `Γ`. -/
inductive Term : Ctx S.Base → Ty S.Base → Type
  /-- A variable. -/
  | var {Γ : Ctx S.Base} {τ : Ty S.Base} : Var Γ τ → Term Γ τ
  /-- Function abstraction `fun x : σ. t`. -/
  | lam {Γ : Ctx S.Base} {σ τ : Ty S.Base} : Term (σ :: Γ) τ → Term Γ (σ ⤳ τ)
  /-- Application `t u`. -/
  | app {Γ : Ctx S.Base} {σ τ : Ty S.Base} : Term Γ (σ ⤳ τ) → Term Γ σ → Term Γ τ
  /-- A fully applied operator. -/
  | op {Γ : Ctx S.Base} {as : List (Ty S.Base)} {τ : Ty S.Base} :
      S.Op as τ → Tuple (Term Γ) as → Term Γ τ

/-- Closed terms of type `τ`, written `Pcf_τ` in the notes. -/
abbrev Closed (τ : Ty S.Base) : Type := Term S [] τ

end Silmaril.Calculi.TypedLambda
