module

public import Silmaril.Calculi.PCF.Examples
public import Mathlib.Computability.PartrecBasis

/-! # Partial recursive functions in PCF

Example 19 of the denotational semantics notes (§5.2): every partial recursive
function `φ : ℕ ⇀ ℕ` has a PCF term `φ'` that evaluates to `φ(n)` whenever
`φ(n)` is defined (`partrec_definable`). This result simulates defined outputs;
it does not require divergence where `φ` is undefined. For total recursive
functions, it gives the specified result at every input.

The proof goes through Mathlib's basis `Nat.Partrec'` of partial recursive
functions `ℕⁿ ⇀ ℕ` on vectors, generated by zero, successor, projections,
composition, primitive recursion and minimisation. An `n`-ary function is
coded, curried, by a closed term of type `nat -> ⋯ -> nat -> nat`
(`Ty.arrows n`). The codings of primitive recursion (`precTerm`) and
minimisation (`rfindTerm`) are those of the notes, with the recursion and
search variable first, as in Mathlib.

Since application is call by name, a coded function may be applied to
arguments that are not yet numerals, for instance in a composition. The
invariant `Realizes t f` therefore asks that `t` applied to *any* closed
arguments evaluating to the numerals of `v` evaluates to the numeral of every
`y ∈ f v`.
-/

@[expose] public section

namespace Silmaril.Calculi.PCF


open TypedLambda Cslib.LambdaCalculus.LocallyNameless.Stlc

/-! ### Curried functions of several arguments -/

/-- The type `nat -> ⋯ -> nat -> nat` of curried functions of `n` numbers. -/
@[reducible] def Ty.arrows : ℕ → Ty
  | 0 => Ty.nat
  | n + 1 => Ty.nat ⤳ arrows n

/-- The context `Γ` extended by `n` variables of type `nat`, the first of
which is bound outermost. -/
def ctxN : ℕ → Ctx Base → Ctx Base
  | 0, Γ => Γ
  | n + 1, Γ => ctxN n (Ty.nat :: Γ)

namespace Term

variable {p : Bool}

/-- The abstraction `fun x₀ ⋯ xₙ₋₁ : nat. b` of `n` numbers. -/
def lams : {Γ : Ctx Base} → (n : ℕ) → Term p (ctxN n Γ) .nat → Term p Γ (Ty.arrows n)
  | _, 0, b => b
  | _, n + 1, b => .lam (lams n b)

/-- The application `t u₀ ⋯ uₙ₋₁` to `n` arguments. -/
def apps : {Γ : Ctx Base} → {n : ℕ} → Term p Γ (Ty.arrows n) → (Fin n → Term p Γ .nat) →
    Term p Γ .nat
  | _, 0, t, _ => t
  | _, _ + 1, t, us => apps (.app t (us 0)) (Fin.tail us)

/-- A variable of `Γ`, as a variable of `ctxN n Γ`. -/
def liftVar {a : Ty} : {Γ : Ctx Base} → (n : ℕ) → Var Γ a → Var (ctxN n Γ) a
  | _, 0, x => x
  | _, n + 1, x => liftVar n (.succ x)

/-- The variable `xᵢ` bound by `lams n`. -/
def argVar : {Γ : Ctx Base} → (n : ℕ) → Fin n → Var (ctxN n Γ) Ty.nat
  | _, n + 1, ⟨0, _⟩ => liftVar n .zero
  | _, n + 1, ⟨i + 1, h⟩ => argVar n ⟨i, Nat.lt_of_succ_lt_succ h⟩

/-- The variables `x₀, …, xₙ₋₁` bound by `lams n`. -/
abbrev args {Γ : Ctx Base} (n : ℕ) : Fin n → Term p (ctxN n Γ) .nat := fun i => .var (argVar n i)

end Term

/-- Extend a substitution by terms for the `n` variables of `ctxN n Γ`. -/
def Subst.extendN {p : Bool} {Δ : Ctx Base} : {Γ : Ctx Base} → (n : ℕ) →
    Subst (sig p) Γ Δ → (Fin n → Term p Δ .nat) → Subst (sig p) (ctxN n Γ) Δ
  | _, 0, s, _ => s
  | _, n + 1, s, us => extendN n (us 0 ::ₜ s) (Fin.tail us)

namespace Subst

variable {p : Bool} {Δ : Ctx Base}

@[simp] theorem extendN_liftVar {a : Ty} : {Γ : Ctx Base} → (n : ℕ) → (s : Subst (sig p) Γ Δ) →
    (us : Fin n → Term p Δ .nat) → (x : Var Γ a) → extendN n s us _ (Term.liftVar n x) = s _ x := sorry

end Subst

/-! ### Head expansion of applications -/

namespace Expands

variable {p : Bool}

/-- Head expansion is a congruence for application to several arguments. -/
theorem apps : {n : ℕ} → {t t' : Closed p (Ty.arrows n)} → Expands t t' →
    (us : Fin n → Closed p .nat) → Expands (Term.apps t us) (Term.apps t' us) := sorry

end Expands

/-! ### Realizers -/

/-- The closed term `t` realizes the partial function `f : ℕⁿ ⇀ ℕ`: applied to
closed arguments that evaluate to the numerals of `v`, it evaluates to the
numeral of every `y ∈ f v`. This is a defined-result simulation: it imposes
no condition on inputs outside the domain of `f`. For total `f`,
`Realizes.total` gives computation at every input. -/
def Realizes {p : Bool} {n : ℕ} (t : Closed p (Ty.arrows n)) (f : List.Vector ℕ n →. ℕ) :
    Prop :=
  ∀ (us : Fin n → Closed p .nat) (v : List.Vector ℕ n),
    (∀ i, us i ⇓ Term.num (v.get i)) → ∀ y ∈ f v, Term.apps t us ⇓ Term.num y

namespace Realizes

variable {p : Bool}

/-- The composition `fun x. f' (g'₀ x) ⋯ (g'ₙ₋₁ x)`. -/
def compTerm {m n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Fin n → Closed p (Ty.arrows m)) :
    Closed p (Ty.arrows m) :=
  Term.lams m (Term.apps (TypedLambda.Term.ofClosed f') fun i =>
    Term.apps (TypedLambda.Term.ofClosed (g' i)) (Term.args m))

/-- The body of `precTerm`. -/
def precBody {n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Closed p (Ty.arrows (n + 2))) :
    Term p (ctxN (n + 1) [Ty.arrows (n + 1)]) .nat :=
  Term.ite (Term.isZero (Term.args (n + 1) 0))
    (Term.apps (TypedLambda.Term.ofClosed f') fun i => Term.args (n + 1) i.succ)
    (Term.apps
      (.app (.app (TypedLambda.Term.ofClosed g')
        (Term.pred (Term.args (n + 1) 0)))
        (Term.apps (.app (.var (Term.liftVar (n + 1) .zero)) (Term.pred (Term.args (n + 1) 0)))
          fun i => Term.args (n + 1) i.succ))
      fun i => Term.args (n + 1) i.succ)

/-- Example 19: primitive recursion. If `f'` codes `f` and `g'` codes `g`, then
`H = fix(fun h. fun y x. if zero?(y) then f' x else g' (pred y) (h (pred y) x) x)`
codes the function `h` with `h(0, x) = f(x)` and `h(y+1, x) = g(y, h(y, x), x)`. -/
def precTerm {n : ℕ} (f' : Closed p (Ty.arrows n)) (g' : Closed p (Ty.arrows (n + 2))) :
    Closed p (Ty.arrows (n + 1)) :=
  Term.fix (.lam (Term.lams (n + 1) (precBody f' g')))

/-- The body of `rfindAux`. -/
def rfindBody {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) :
    Term p (ctxN (n + 1) [Ty.arrows (n + 1)]) .nat :=
  Term.ite (Term.isZero (Term.apps (TypedLambda.Term.ofClosed k') (Term.args (n + 1))))
    (Term.args (n + 1) 0)
    (Term.apps (.app (.var (Term.liftVar (n + 1) .zero)) (Term.succ (Term.args (n + 1) 0)))
      fun i => Term.args (n + 1) i.succ)

/-- Example 19: the search of a minimisation,
`m' = fix(fun m'. fun y x. if zero?(k' y x) then y else m' (succ(y)) x)`. -/
def rfindAux {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) : Closed p (Ty.arrows (n + 1)) :=
  Term.fix (.lam (Term.lams (n + 1) (rfindBody k')))

/-- Example 19: minimisation. If `k'` codes `k`, then `fun x. m' 0 x` codes the
function `m` with `m(x)` the least `y` such that `k(y, x) = 0`. -/
def rfindTerm {n : ℕ} (k' : Closed p (Ty.arrows (n + 1))) : Closed p (Ty.arrows n) :=
  Term.lams n (Term.apps (.app (TypedLambda.Term.ofClosed (rfindAux k')) Term.zero) (Term.args n))

end Realizes

/-! ### Example 19 -/

variable {p : Bool}

/-- Example 19, for `Nat.Partrec`. -/
theorem nat_partrec_definable {f : ℕ →. ℕ} (hf : Nat.Partrec f) :
    ∃ t : Closed false (Ty.nat ⤳ Ty.nat), ∀ n, ∀ y ∈ f n, .app t (Term.num n) ⇓ Term.num y := sorry

end Silmaril.Calculi.PCF
