      "search": {},
      "tools": {},
      "tracks": {},
      "trajectory": {},
      "workspace": {},
      "yields": {}
    },
    "trigger": {
      "cron": {},
      "dead_at_startup": {},
      "low_water": {},
      "low_yield": {},
      "news": {},
      "run_failed": {},
      "stalled": {},
      "stopped": {}
