{
  "name": "my-campaign",
  "metrics": [
    {
      "floor": null,
      "margin": null,
      "fraction": null,
      "name": "score",
      "direction": "higher",
      "role": "primary",
      "track": null,
      "ratio": null,
      "repeats": null
    }
  ],
  "tracks": {},
  "evaluate": [
    "uv",
    "run",
    "python",
    "evaluate.py"
  ],
  "evaluate_timeout": 600.0,
  "ladder": [],
  "link": [],
  "context": [],
  "agents": {
    "wrap_up_grace": null,
    "brief_words": null
  },
  "plugins": {
    "runtime": {
      "use": "subprocess"
    },
    "harness": {
      "use": [
        "pi",
        "claude",
        "codex"
      ],
      "claude": {
        "model": "claude-opus-5-5"
      },
      "codex": {
        "model": "gpt-6.1-sol"
      },
      "pi": {
        "model": "anthropic/claude-opus-5-5"
      }
    },
    "role": {
      "implementer": {
        "timeout": 1800.0,
        "max_concurrent": 4,
        "runs": true
      },
      "orchestrator": {
        "timeout": 900.0,
        "max_concurrent": 1,
        "runs": false,
        "triggers": []
      },
      "research": {
        "timeout": 900.0,
        "max_concurrent": 1,
        "runs": false,
        "triggers": [
          "low_water",
          "stalled"
        ],
        "max_ideas": 3
      },
      "watchdog": {
        "timeout": 600.0,
        "max_concurrent": 1,
        "runs": false,
        "triggers": [
          "run_failed",
          "dead_at_startup",
          "low_yield",
          "cron",
          "stopped"
        ],
        "interval": 1800.0,
        "max_ideas": 1
      }
    },
    "fact_source": {
      "use": [
        "campaign",
        "optimization"
      ],
      "campaign": {},
      "leases": {},
      "models": {},
      "optimization": {},
      "spend": {}
    },
    "lineage": {
      "use": "optimization",
      "optimization": {}
    },
    "mcp_server": {},
    "notifier": {
      "slack": {}
    },
    "section": {
      "use": [
        "headline",
        "goal",
        "tracks",
        "trajectory",
        "runs",
        "queue",
        "idle_queue",
        "agents",
        "evaluations",
        "funnel",
        "yields",
